   "missing_card": {
    "risk_level": "medium",
    "zh": {
     "title": "租约没写押金怎么退",
     "explanation": "租约里没有找到押金退还期限、扣款清单或收据的约定。没写不代表房东可以不退，但退押金时更容易起争议。",
     "suggestion": "签约前请房东写明退还期限和扣款方式。"
    },
    "en": {
     "title": "Lease does not say how the deposit is returned",
     "explanation": "The lease has no terms on the return deadline, itemized deductions or receipts. That does not let the landlord keep the deposit, but it makes disputes more likely.",
     "suggestion": "Ask the landlord to state the return deadline and how deductions work."
    }
